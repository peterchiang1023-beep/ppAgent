# ===== Claude API =====
# 到 https://console.anthropic.com/ 取得金鑰。請複製本檔為 .env 後填入，.env 不可提交到版本控制。
ANTHROPIC_API_KEY=

# ===== 模型設定 =====
# 主管 Agent 使用的模型
SUPERVISOR_MODEL=claude-opus-5-5
# 子 Agent 使用的模型（較省成本）
SUBAGENT_MODEL=claude-sonnet-5-5

# ===== 預算與呼叫上限（超過即停止並通知）=====
# 每日總預算（美元）
DAILY_BUDGET_USD=5
# 每日工具呼叫次數上限（含網路搜尋、網頁讀取、自訂工具）
DAILY_TOOL_CALL_LIMIT=300
# 單次執行預算上限（美元）
RUN_BUDGET_USD=2
# 單次執行最多對話回合數
MAX_TURNS=60

# ===== 報告品質 =====
# 報告至少需包含的資料來源連結數
MIN_REPORT_SOURCES=5

# ===== HTTP API（server.py）=====
# 設定後，所有 API 請求都必須帶 X-API-Key 標頭；本機測試可留空
SERVER_API_KEY=
